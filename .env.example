# SmartBudget AI – Environment Configuration
# Copy this file to .env and insert your Gemini API Key

# Your Google Gemini API Key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model choice (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Local Server Port (Default: 8000)
PORT=8000
